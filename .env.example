# PENDING CHANGE (2026-08-31): this app is going standalone (own DB, no
# dependency on the management app) — see
# docs/features/standalone-signup/spec.md. These three vars
# (MANAGEMENT_APP_BASE_URL, PUBLIC_PROXY_SECRET, NEXT_PUBLIC_GENERIC_JOIN_CODE)
# are still what the currently-deployed code actually reads; they go away
# once that spec is implemented, replaced by a DATABASE_URL.

# Base URL of the management app (corporations repo, /app), server-side only.
# Never exposed to the browser — the browser only ever calls this app's own
# /api/proxy/* routes. See lib/proxy.ts and
# docs/features/leadMachine/2026-08-26-supporter-self-signup-design.md
# ("Same-origin proxy") in the corporations repo.
MANAGEMENT_APP_BASE_URL=https://app.rbac.shop

# Shared secret sent as X-Public-Proxy-Secret on every proxied request.
# Must match the same value configured on the management app. Generate a
# long random value per environment; never commit the real value.
PUBLIC_PROXY_SECRET=

# The generic SupportLink code used by /join (no personal recruiter).
# Public — it's a link code by definition, not a secret (see the sibling
# spec's "Primary CTA routing" section for why).
NEXT_PUBLIC_GENERIC_JOIN_CODE=

# Used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://join.example.org
