generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SupportSignup {
  id                 String   @id @default(uuid())
  fullName           String   @db.VarChar(200)
  phone              String   @db.VarChar(30)
  cityName           String?  @db.VarChar(100)
  referralCode       String?  @db.VarChar(64)
  clientSubmissionId String   @unique
  payloadDigest      String
  ip                 String
  honeypotTripped    Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([createdAt, id])
  @@map("support_signups")
}

// Mirrors a PII-free subset of corporations' ReferralLink rows (opaque
// code, active flag, optional city snapshot) so /join can validate a code
// and prefill a city entirely locally, with zero runtime call back to
// corporations. Populated only by the inbound sync endpoint, full-list-
// replace semantics — see docs/superpowers/specs/2026-09-01-referral-signup-links-design.md
// (corporations repo) Component 2.
model ReferralLinkMirror {
  code      String   @id
  active    Boolean  @default(true)
  cityName  String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt

  @@map("referral_link_mirrors")
}

model SignupRateLimitBucket {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  ip          String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([ip, windowStart], name: "ip_windowStart")
  @@map("signup_rate_limit_buckets")
}
